# =====================================================================
# Kotak Neo API Credentials Configuration (.env)
# =====================================================================
# Copy this file to .env:
#     copy .env.example .env
# Then fill in your actual credentials below.

# 1. Consumer Key (REQUIRED)
# How to get:
#   - Login to Kotak Neo App or Web (https://www.kotaksecurities.com)
#   - Navigate to 'More' tab -> 'Trade API' card
#   - Click 'Generate Application' (or view default application)
#   - Copy the Token and paste it here:
NEO_CONSUMER_KEY=your-consumer-key-token-here

# 2. Registered Mobile Number (REQUIRED)
# Registered mobile number with Kotak Neo (with country code e.g. +91)
NEO_MOBILE_NUMBER=+91XXXXXXXXXX

# 3. User Client Code - UCC (REQUIRED)
# Find this in Kotak Neo App/Web under Profile section
NEO_UCC=YOUR_UCC

# 4. Trading MPIN (REQUIRED)
# Your 6-digit MPIN used for Kotak Neo 2FA / trading authorization
NEO_MPIN=XXXXXX

# 5. TOTP Secret Key (OPTIONAL - Highly Recommended for Algo Trading)
# How to get:
#   - When registering for TOTP on Kotak Neo API Dashboard (More -> Trade API -> TOTP Registration)
#   - Copy the alphanumeric secret key provided below the QR code
#   - If provided, login.py will automatically generate 6-digit TOTP codes without manual entry!
NEO_TOTP_SECRET=your-totp-secret-key-here

# 6. Environment (OPTIONAL)
# 'prod' for production (default), 'uat' for testing
NEO_ENVIRONMENT=prod
